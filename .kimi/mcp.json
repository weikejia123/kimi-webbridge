{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "npm_config_loglevel": "error",
        "NODE_NO_WARNINGS": "1"
      },
      "startup_timeout_sec": 15
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "startup_timeout_sec": 15
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}
